# ═══════════════════════════════════════════════════════════════════
# Rucher Manager — variables d'environnement
# Copiez ce fichier en « .env » et adaptez les valeurs (le script
# deploy-synology.sh le génère automatiquement avec des secrets aléatoires).
# ═══════════════════════════════════════════════════════════════════

# ─── Base de données ───────────────────────────────────────────────
# ⚠️  IMPORTANT : ce mot de passe n'est pris en compte qu'à la PREMIÈRE
# initialisation du volume PostgreSQL. Si vous le changez ensuite, vous
# obtiendrez « password authentication failed » — il faut alors réinitialiser
# le volume :  ./deploy-synology.sh --reset-db   (⚠️ efface les données).
POSTGRES_PASSWORD=change-me-strong-password

# ─── Sécurité JWT ──────────────────────────────────────────────────
# Générez une clé forte :  openssl rand -hex 32
SECRET_KEY=change-me-in-production

# ─── Premier compte administrateur (créé au 1er démarrage) ─────────
FIRST_ADMIN_EMAIL=admin@rucher.local
FIRST_ADMIN_PASSWORD=admin1234

# ─── Réseau ────────────────────────────────────────────────────────
# Port HTTP local exposé par la stack. Le proxy inverse du Synology
# (ruches.corsicajack.fr → localhost:WEB_PORT) et l'accès LAN direct
# (http://IP_DU_NAS:WEB_PORT) pointent vers ce port.
WEB_PORT=7080

# ─── Sauvegarde automatique (conteneur « backup » isolé) ───────────
# Intervalle entre deux sauvegardes (en secondes ; 86400 = 24 h)
BACKUP_INTERVAL=86400
# Nombre de sauvegardes conservées (rotation)
BACKUP_KEEP=14

# ─── Sauvegarde hebdomadaire (rétention longue) ────────────────────
# Nombre d'instantanés hebdomadaires conservés dans ./backups/weekly
WEEKLY_BACKUP_KEEP=12

# ─── Envoi d'e-mails (récapitulatif hebdomadaire) ──────────────────
# Laisser SMTP_HOST vide désactive complètement l'envoi.
# Exemple pour Gmail : smtp.gmail.com / 587 / starttls + mot de passe
# d'application (les mots de passe de compte ne fonctionnent pas).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TLS=starttls          # starttls | ssl | none

# ─── Récapitulatif hebdomadaire ────────────────────────────────────
DIGEST_ENABLED=true
# ⚠️ Les identifiants de connexion (paulin, luc…) ne sont PAS des adresses
# e-mail : renseignez ici les vraies adresses, séparées par des virgules.
DIGEST_RECIPIENTS=
DIGEST_WEEKDAY=0           # 0 = lundi … 6 = dimanche
DIGEST_HOUR=8              # heure locale du serveur
# Adresse publique de l'application (bouton dans l'e-mail récapitulatif)
APP_BASE_URL=https://ruches.corsicajack.fr
